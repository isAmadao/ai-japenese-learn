# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=ai_japanese_learn

# SQLite fallback (set to true to use SQLite instead of MySQL)
USE_SQLITE=true
SQLITE_PATH=./data/app.db

# Redis (used for cache — agent results TTL=1h, articles TTL=2h)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Milvus (vector DB — stores word/article embeddings for semantic search)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# LLM — Qwen via OpenAI-compatible API
LLM_API_KEY=sk-9f96f86d7029428bbb74d78d33859df2
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_EMBEDDING_MODEL=text-embedding-v3

# Cache TTL (seconds)
CACHE_TTL_WORDS=3600
CACHE_TTL_ARTICLE=7200

# Server
HOST=0.0.0.0
PORT=8000
